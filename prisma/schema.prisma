generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
}

model Business {
  id                  BigInt   @id @default(autoincrement()) @db.UnsignedBigInt
  business_name       String   @db.VarChar(180)
  legal_name          String?  @db.VarChar(180)
  registration_number String?  @db.VarChar(80)
  gstin               String?  @db.VarChar(20)
  address             String?  @db.Text
  city                String?  @db.VarChar(100)
  state               String?  @db.VarChar(100)
  pincode             String?  @db.VarChar(12)
  phone               String?  @db.VarChar(20)
  email               String?  @db.VarChar(150)
  created_at          DateTime @default(now()) @db.DateTime(0)
  updated_at          DateTime @updatedAt @db.DateTime(0)

  @@map("businesses")
}

model Branch {
  id              BigInt         @id @default(autoincrement()) @db.UnsignedBigInt
  branch_code     String         @unique @db.VarChar(30)
  branch_name     String         @db.VarChar(150)
  address         String?        @db.Text
  city            String?        @db.VarChar(100)
  state           String?        @db.VarChar(100)
  pincode         String?        @db.VarChar(12)
  phone           String?        @db.VarChar(20)
  email           String?        @db.VarChar(150)
  gstin           String?        @db.VarChar(20)
  is_active       Boolean        @default(true)
  created_at      DateTime       @default(now()) @db.DateTime(0)
  updated_at      DateTime       @updatedAt @db.DateTime(0)
  default_users         User[]               @relation("UserDefaultBranch")
  user_branches         UserBranch[]
  branch_product_prices BranchProductPrice[]
  invoice_sequences     InvoiceSequence[]
  offer_branches        OfferBranch[]
  sales_invoices        SalesInvoice[]
  sales_returns         SalesReturn[]
  payments              Payment[]
  activity_logs         ActivityLog[]
  sync_devices          SyncDevice[]
  counters              Counter[]
  cash_shifts           CashShift[]

  @@map("branches")
}

model Role {
  id               BigInt           @id @default(autoincrement()) @db.UnsignedBigInt
  name             String           @unique @db.VarChar(80)
  description      String?          @db.VarChar(255)
  is_active        Boolean          @default(true)
  created_at       DateTime         @default(now()) @db.DateTime(0)
  updated_at       DateTime         @updatedAt @db.DateTime(0)
  users            User[]
  role_permissions RolePermission[]

  @@map("roles")
}

model Permission {
  id               BigInt           @id @default(autoincrement()) @db.UnsignedBigInt
  name             String           @db.VarChar(120)
  permission_key   String           @unique @db.VarChar(150)
  module           String           @db.VarChar(80)
  created_at       DateTime         @default(now()) @db.DateTime(0)
  role_permissions RolePermission[]

  @@map("permissions")
}

model RolePermission {
  id            BigInt     @id @default(autoincrement()) @db.UnsignedBigInt
  role_id       BigInt     @db.UnsignedBigInt
  permission_id BigInt     @db.UnsignedBigInt
  created_at    DateTime   @default(now()) @db.DateTime(0)
  role          Role       @relation(fields: [role_id], references: [id], onDelete: Restrict, onUpdate: Cascade)
  permission    Permission @relation(fields: [permission_id], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@unique([role_id, permission_id], map: "uq_role_permission")
  @@index([permission_id])
  @@map("role_permissions")
}

model User {
  id                BigInt       @id @default(autoincrement()) @db.UnsignedBigInt
  name              String       @db.VarChar(150)
  email             String       @unique @db.VarChar(150)
  phone             String?      @db.VarChar(20)
  employee_code     String?      @unique @db.VarChar(40)
  password          String       @db.VarChar(255)
  role_id           BigInt       @db.UnsignedBigInt
  default_branch_id BigInt?      @db.UnsignedBigInt
  is_active         Boolean      @default(true)
  last_login        DateTime?    @db.DateTime(0)
  created_at        DateTime     @default(now()) @db.DateTime(0)
  updated_at        DateTime     @updatedAt @db.DateTime(0)
  role              Role         @relation(fields: [role_id], references: [id], onDelete: Restrict, onUpdate: Cascade)
  default_branch            Branch?         @relation("UserDefaultBranch", fields: [default_branch_id], references: [id], onDelete: Restrict, onUpdate: Cascade)
  user_branches             UserBranch[]
  sales_invoices_created    SalesInvoice[]  @relation("InvoiceCreatedBy")
  sales_invoices_sold       SalesInvoice[]  @relation("InvoiceSalesperson")
  payments_received         Payment[]       @relation("PaymentReceivedBy")
  sales_returns_created     SalesReturn[]   @relation("ReturnCreatedBy")
  activity_logs             ActivityLog[]
  cash_shift_users          CashShiftUser[]

  @@index([role_id])
  @@index([default_branch_id])
  @@map("users")
}

model Customer {
  id               BigInt    @id @default(autoincrement()) @db.UnsignedBigInt
  customer_code    String?   @unique @db.VarChar(50)
  customer_name    String    @db.VarChar(150)
  phone            String?   @db.VarChar(20)
  email            String?   @db.VarChar(150)
  gender           String?   @db.VarChar(20)
  date_of_birth    DateTime? @db.Date
  anniversary_date DateTime? @db.Date
  address          String?   @db.Text
  city             String?   @db.VarChar(100)
  state            String?   @db.VarChar(100)
  pincode          String?   @db.VarChar(12)
  gstin            String?   @db.VarChar(20)
  created_at       DateTime       @default(now()) @db.DateTime(0)
  updated_at       DateTime       @updatedAt @db.DateTime(0)
  sales_invoices   SalesInvoice[]

  @@index([phone], map: "idx_customers_phone")
  @@map("customers")
}

model Unit {
  id          BigInt    @id @default(autoincrement()) @db.UnsignedBigInt
  unit_name   String    @db.VarChar(80)
  unit_symbol String    @unique @db.VarChar(20)
  is_active   Boolean   @default(true)
  products    Product[]

  @@map("units")
}

model TaxRate {
  id                    BigInt               @id @default(autoincrement()) @db.UnsignedBigInt
  tax_name              String               @db.VarChar(100)
  tax_percentage        Decimal              @default(0.000) @db.Decimal(7, 3)
  tax_type              String               @db.VarChar(30)
  is_active             Boolean              @default(true)
  created_at            DateTime             @default(now()) @db.DateTime(0)
  updated_at            DateTime             @updatedAt @db.DateTime(0)
  branch_product_prices BranchProductPrice[]

  @@map("tax_rates")
}

model ProductCategory {
  id            BigInt            @id @default(autoincrement()) @db.UnsignedBigInt
  parent_id     BigInt?           @db.UnsignedBigInt
  category_name String            @db.VarChar(120)
  description   String?           @db.Text
  is_active     Boolean           @default(true)
  created_at    DateTime          @default(now()) @db.DateTime(0)
  updated_at    DateTime          @updatedAt @db.DateTime(0)
  parent        ProductCategory?  @relation("CategoryParent", fields: [parent_id], references: [id], onDelete: Restrict, onUpdate: Restrict)
  children      ProductCategory[] @relation("CategoryParent")
  products      Product[]

  @@index([parent_id])
  @@map("product_categories")
}

model Product {
  id           BigInt           @id @default(autoincrement()) @db.UnsignedBigInt
  category_id  BigInt?          @db.UnsignedBigInt
  product_name String           @db.VarChar(180)
  product_code String?          @unique @db.VarChar(80)
  description  String?          @db.Text
  unit_id      BigInt?          @db.UnsignedBigInt
  hsn_code     String?          @db.VarChar(20)
  is_active    Boolean          @default(true)
  created_at   DateTime         @default(now()) @db.DateTime(0)
  updated_at   DateTime         @updatedAt @db.DateTime(0)
  category     ProductCategory? @relation(fields: [category_id], references: [id], onDelete: Restrict, onUpdate: Restrict)
  unit         Unit?            @relation(fields: [unit_id], references: [id], onDelete: Restrict, onUpdate: Restrict)
  variants     ProductVariant[]

  @@index([category_id])
  @@index([unit_id])
  @@map("products")
}

model ProductVariant {
  id              BigInt               @id @default(autoincrement()) @db.UnsignedBigInt
  product_id      BigInt               @db.UnsignedBigInt
  variant_name    String               @db.VarChar(150)
  sku             String               @unique @db.VarChar(100)
  barcode         String?              @unique @db.VarChar(100)
  purchase_price  Decimal              @default(0.00) @db.Decimal(12, 2)
  selling_price   Decimal              @default(0.00) @db.Decimal(12, 2)
  mrp             Decimal              @default(0.00) @db.Decimal(12, 2)
  is_active       Boolean              @default(true)
  created_at      DateTime             @default(now()) @db.DateTime(0)
  updated_at      DateTime             @updatedAt @db.DateTime(0)
  product         Product              @relation(fields: [product_id], references: [id], onDelete: Restrict, onUpdate: Restrict)
  branch_prices   BranchProductPrice[]
  invoice_items   SalesInvoiceItem[]
  return_items    SalesReturnItem[]
  offer_products  OfferProduct[]

  @@index([product_id])
  @@map("product_variants")
}

model BranchProductPrice {
  id                 BigInt         @id @default(autoincrement()) @db.UnsignedBigInt
  branch_id          BigInt         @db.UnsignedBigInt
  product_variant_id BigInt         @db.UnsignedBigInt
  purchase_price     Decimal        @default(0.00) @db.Decimal(12, 2)
  selling_price      Decimal        @default(0.00) @db.Decimal(12, 2)
  mrp                Decimal        @default(0.00) @db.Decimal(12, 2)
  stock_quantity     Decimal        @default(0.000) @db.Decimal(12, 3)
  tax_rate_id        BigInt?        @db.UnsignedBigInt
  updated_at         DateTime       @updatedAt @db.DateTime(0)
  branch             Branch         @relation(fields: [branch_id], references: [id], onDelete: Restrict, onUpdate: Restrict)
  product_variant    ProductVariant @relation(fields: [product_variant_id], references: [id], onDelete: Restrict, onUpdate: Restrict)
  tax_rate           TaxRate?       @relation(fields: [tax_rate_id], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@unique([branch_id, product_variant_id], map: "uq_branch_variant_price")
  @@index([product_variant_id])
  @@index([tax_rate_id])
  @@map("branch_product_prices")
}

model UserBranch {
  id         BigInt   @id @default(autoincrement()) @db.UnsignedBigInt
  user_id    BigInt   @db.UnsignedBigInt
  branch_id  BigInt   @db.UnsignedBigInt
  created_at DateTime @default(now()) @db.DateTime(0)
  user       User     @relation(fields: [user_id], references: [id], onDelete: Restrict, onUpdate: Cascade)
  branch     Branch   @relation(fields: [branch_id], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@unique([user_id, branch_id], map: "uq_user_branch")
  @@index([branch_id])
  @@map("user_branches")
}

model PaymentMode {
  id         BigInt    @id @default(autoincrement()) @db.UnsignedBigInt
  mode_name  String    @unique @db.VarChar(60)
  is_active     Boolean       @default(true)
  payments      Payment[]
  sales_returns SalesReturn[]

  @@map("payment_modes")
}

model InvoiceSequence {
  id             BigInt   @id @default(autoincrement()) @db.UnsignedBigInt
  branch_id      BigInt   @db.UnsignedBigInt
  financial_year String   @db.VarChar(9)
  prefix         String   @db.VarChar(30)
  last_number    BigInt   @default(0) @db.UnsignedBigInt
  updated_at     DateTime @updatedAt @db.DateTime(0)
  branch         Branch   @relation(fields: [branch_id], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@unique([branch_id, financial_year], map: "uq_branch_financial_year")
  @@map("invoice_sequences")
}

model Offer {
  id               BigInt         @id @default(autoincrement()) @db.UnsignedBigInt
  offer_name       String         @db.VarChar(150)
  offer_code       String?        @unique @db.VarChar(60)
  discount_type    String         @db.VarChar(30)
  discount_value   Decimal        @db.Decimal(12, 2)
  minimum_purchase Decimal        @default(0.00) @db.Decimal(12, 2)
  maximum_discount Decimal?       @db.Decimal(12, 2)
  start_date       DateTime       @db.DateTime(0)
  end_date         DateTime       @db.DateTime(0)
  is_active        Boolean        @default(true)
  created_at       DateTime       @default(now()) @db.DateTime(0)
  updated_at       DateTime       @updatedAt @db.DateTime(0)
  offer_branches   OfferBranch[]
  offer_products   OfferProduct[]

  @@map("offers")
}

model OfferBranch {
  id        BigInt @id @default(autoincrement()) @db.UnsignedBigInt
  offer_id  BigInt @db.UnsignedBigInt
  branch_id BigInt @db.UnsignedBigInt
  offer     Offer  @relation(fields: [offer_id], references: [id], onDelete: Restrict, onUpdate: Restrict)
  branch    Branch @relation(fields: [branch_id], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@unique([offer_id, branch_id], map: "uq_offer_branch")
  @@index([branch_id])
  @@map("offer_branches")
}

model OfferProduct {
  id                 BigInt         @id @default(autoincrement()) @db.UnsignedBigInt
  offer_id           BigInt         @db.UnsignedBigInt
  product_variant_id BigInt         @db.UnsignedBigInt
  offer              Offer          @relation(fields: [offer_id], references: [id], onDelete: Restrict, onUpdate: Restrict)
  product_variant    ProductVariant @relation(fields: [product_variant_id], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@unique([offer_id, product_variant_id], map: "uq_offer_variant")
  @@index([product_variant_id])
  @@map("offer_products")
}

model SalesInvoice {
  id               BigInt             @id @default(autoincrement()) @db.UnsignedBigInt
  invoice_number   String             @db.VarChar(80)
  branch_id        BigInt             @db.UnsignedBigInt
  customer_id      BigInt?            @db.UnsignedBigInt
  salesperson_id   BigInt?            @db.UnsignedBigInt
  invoice_date     DateTime           @db.DateTime(0)
  subtotal         Decimal            @default(0.00) @db.Decimal(14, 2)
  discount_amount  Decimal            @default(0.00) @db.Decimal(14, 2)
  taxable_amount   Decimal            @default(0.00) @db.Decimal(14, 2)
  cgst_amount      Decimal            @default(0.00) @db.Decimal(14, 2)
  sgst_amount      Decimal            @default(0.00) @db.Decimal(14, 2)
  igst_amount      Decimal            @default(0.00) @db.Decimal(14, 2)
  tax_amount       Decimal            @default(0.00) @db.Decimal(14, 2)
  round_off        Decimal            @default(0.00) @db.Decimal(8, 2)
  grand_total      Decimal            @default(0.00) @db.Decimal(14, 2)
  paid_amount      Decimal            @default(0.00) @db.Decimal(14, 2)
  due_amount       Decimal            @default(0.00) @db.Decimal(14, 2)
  payment_status   String             @default("unpaid") @db.VarChar(30)
  invoice_status   String             @default("completed") @db.VarChar(30)
  notes            String?            @db.Text
  created_by       BigInt             @db.UnsignedBigInt
  created_at       DateTime           @default(now()) @db.DateTime(0)
  updated_at       DateTime           @updatedAt @db.DateTime(0)
  branch           Branch             @relation(fields: [branch_id], references: [id], onDelete: Restrict, onUpdate: Restrict)
  customer         Customer?          @relation(fields: [customer_id], references: [id], onDelete: Restrict, onUpdate: Restrict)
  salesperson      User?              @relation("InvoiceSalesperson", fields: [salesperson_id], references: [id], onDelete: Restrict, onUpdate: Restrict)
  creator          User               @relation("InvoiceCreatedBy", fields: [created_by], references: [id], onDelete: Restrict, onUpdate: Restrict)
  items            SalesInvoiceItem[]
  payments         Payment[]
  returns          SalesReturn[]

  @@unique([branch_id, invoice_number], map: "uq_branch_invoice_number")
  @@index([customer_id])
  @@index([salesperson_id])
  @@index([created_by])
  @@index([branch_id, invoice_date], map: "idx_invoice_date")
  @@map("sales_invoices")
}

model SalesInvoiceItem {
  id                 BigInt         @id @default(autoincrement()) @db.UnsignedBigInt
  invoice_id         BigInt         @db.UnsignedBigInt
  product_variant_id BigInt         @db.UnsignedBigInt
  product_name       String         @db.VarChar(180)
  sku                String?        @db.VarChar(100)
  hsn_code           String?        @db.VarChar(20)
  quantity           Decimal        @db.Decimal(12, 3)
  unit_price         Decimal        @db.Decimal(12, 2)
  discount_type      String?        @db.VarChar(30)
  discount_value     Decimal        @default(0.00) @db.Decimal(12, 2)
  discount_amount    Decimal        @default(0.00) @db.Decimal(12, 2)
  taxable_amount     Decimal        @default(0.00) @db.Decimal(14, 2)
  tax_rate           Decimal        @default(0.000) @db.Decimal(7, 3)
  cgst_amount        Decimal        @default(0.00) @db.Decimal(14, 2)
  sgst_amount        Decimal        @default(0.00) @db.Decimal(14, 2)
  igst_amount        Decimal        @default(0.00) @db.Decimal(14, 2)
  tax_amount         Decimal        @default(0.00) @db.Decimal(14, 2)
  total_amount       Decimal        @db.Decimal(14, 2)
  invoice            SalesInvoice      @relation(fields: [invoice_id], references: [id], onDelete: Restrict, onUpdate: Restrict)
  product_variant    ProductVariant    @relation(fields: [product_variant_id], references: [id], onDelete: Restrict, onUpdate: Restrict)
  return_items       SalesReturnItem[]

  @@index([invoice_id], map: "idx_invoice_items_invoice")
  @@index([product_variant_id])
  @@map("sales_invoice_items")
}

model SalesReturn {
  id            BigInt            @id @default(autoincrement()) @db.UnsignedBigInt
  return_number String            @unique @db.VarChar(80)
  invoice_id    BigInt            @db.UnsignedBigInt
  branch_id     BigInt            @db.UnsignedBigInt
  return_date   DateTime          @db.DateTime(0)
  total_amount  Decimal           @default(0.00) @db.Decimal(14, 2)
  tax_amount    Decimal           @default(0.00) @db.Decimal(14, 2)
  refund_amount Decimal           @default(0.00) @db.Decimal(14, 2)
  refund_mode_id BigInt?          @db.UnsignedBigInt
  notes         String?           @db.Text
  created_by    BigInt            @db.UnsignedBigInt
  created_at    DateTime          @default(now()) @db.DateTime(0)
  invoice       SalesInvoice      @relation(fields: [invoice_id], references: [id], onDelete: Restrict, onUpdate: Restrict)
  branch        Branch            @relation(fields: [branch_id], references: [id], onDelete: Restrict, onUpdate: Restrict)
  refund_mode   PaymentMode?      @relation(fields: [refund_mode_id], references: [id], onDelete: Restrict, onUpdate: Restrict)
  creator       User              @relation("ReturnCreatedBy", fields: [created_by], references: [id], onDelete: Restrict, onUpdate: Restrict)
  items         SalesReturnItem[]

  @@index([invoice_id])
  @@index([branch_id, return_date], map: "idx_returns_branch_date")
  @@index([refund_mode_id])
  @@index([created_by])
  @@map("sales_returns")
}

model SalesReturnItem {
  id                 BigInt           @id @default(autoincrement()) @db.UnsignedBigInt
  return_id          BigInt           @db.UnsignedBigInt
  invoice_item_id    BigInt           @db.UnsignedBigInt
  product_variant_id BigInt           @db.UnsignedBigInt
  quantity           Decimal          @db.Decimal(12, 3)
  total_amount       Decimal          @db.Decimal(14, 2)
  sales_return       SalesReturn      @relation(fields: [return_id], references: [id], onDelete: Restrict, onUpdate: Restrict)
  invoice_item       SalesInvoiceItem @relation(fields: [invoice_item_id], references: [id], onDelete: Restrict, onUpdate: Restrict)
  product_variant    ProductVariant   @relation(fields: [product_variant_id], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@index([return_id])
  @@index([invoice_item_id])
  @@index([product_variant_id])
  @@map("sales_return_items")
}

model Payment {
  id                    BigInt       @id @default(autoincrement()) @db.UnsignedBigInt
  invoice_id            BigInt       @db.UnsignedBigInt
  branch_id             BigInt       @db.UnsignedBigInt
  payment_mode_id       BigInt       @db.UnsignedBigInt
  amount                Decimal      @db.Decimal(14, 2)
  transaction_reference String?      @db.VarChar(150)
  payment_date          DateTime     @db.DateTime(0)
  notes                 String?      @db.Text
  received_by           BigInt       @db.UnsignedBigInt
  created_at            DateTime     @default(now()) @db.DateTime(0)
  invoice               SalesInvoice @relation(fields: [invoice_id], references: [id], onDelete: Restrict, onUpdate: Restrict)
  branch                Branch       @relation(fields: [branch_id], references: [id], onDelete: Restrict, onUpdate: Restrict)
  payment_mode          PaymentMode  @relation(fields: [payment_mode_id], references: [id], onDelete: Restrict, onUpdate: Restrict)
  receiver              User         @relation("PaymentReceivedBy", fields: [received_by], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@index([invoice_id])
  @@index([payment_mode_id])
  @@index([received_by])
  @@index([branch_id, payment_date], map: "idx_payments_branch_date")
  @@map("payments")
}

model ActivityLog {
  id          BigInt    @id @default(autoincrement()) @db.UnsignedBigInt
  user_id     BigInt?   @db.UnsignedBigInt
  branch_id   BigInt?   @db.UnsignedBigInt
  action      String    @db.VarChar(100)
  module      String    @db.VarChar(80)
  record_id   String?   @db.VarChar(100)
  description String?   @db.Text
  created_at  DateTime  @default(now()) @db.DateTime(0)
  user        User?     @relation(fields: [user_id], references: [id], onDelete: Restrict, onUpdate: Restrict)
  branch      Branch?   @relation(fields: [branch_id], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@index([branch_id, created_at], map: "idx_activity_branch_created")
  @@index([user_id, created_at], map: "idx_activity_user_created")
  @@map("activity_logs")
}

model SyncDevice {
  id             BigInt              @id @default(autoincrement()) @db.UnsignedBigInt
  branch_id      BigInt              @db.UnsignedBigInt
  device_uuid    String              @unique @db.Char(36)
  device_name    String?             @db.VarChar(150)
  last_sync_at   DateTime?           @db.DateTime(0)
  is_active      Boolean             @default(true)
  created_at     DateTime            @default(now()) @db.DateTime(0)
  branch         Branch              @relation(fields: [branch_id], references: [id], onDelete: Restrict, onUpdate: Restrict)
  entity_versions SyncEntityVersion[]
  sync_logs      SyncLog[]
  sync_outbox    SyncOutbox[]

  @@index([branch_id])
  @@map("sync_devices")
}

model SyncEntityVersion {
  id          BigInt      @id @default(autoincrement()) @db.UnsignedBigInt
  entity_type String      @db.VarChar(80)
  entity_id   String      @db.VarChar(100)
  version     BigInt      @default(1) @db.UnsignedBigInt
  updated_at  DateTime    @updatedAt @db.DateTime(0)
  device_id   BigInt?     @db.UnsignedBigInt
  device      SyncDevice? @relation(fields: [device_id], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@unique([entity_type, entity_id], map: "uq_sync_entity")
  @@index([device_id])
  @@map("sync_entity_versions")
}

model SyncLog {
  id               BigInt     @id @default(autoincrement()) @db.UnsignedBigInt
  device_id        BigInt     @db.UnsignedBigInt
  sync_type        String     @db.VarChar(30)
  started_at       DateTime   @db.DateTime(0)
  completed_at     DateTime?  @db.DateTime(0)
  status           String     @db.VarChar(30)
  records_sent     Int        @default(0) @db.UnsignedInt
  records_received Int        @default(0) @db.UnsignedInt
  error_message    String?    @db.Text
  device           SyncDevice @relation(fields: [device_id], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@index([device_id, started_at], map: "idx_sync_device_started")
  @@map("sync_logs")
}

model SyncOutbox {
  id             BigInt     @id @default(autoincrement()) @db.UnsignedBigInt
  device_id      BigInt     @db.UnsignedBigInt
  entity_type    String     @db.VarChar(80)
  entity_id      String     @db.VarChar(100)
  operation_type String     @db.VarChar(20)
  payload        String     @db.LongText
  status         String     @default("pending") @db.VarChar(20)
  retry_count    Int        @default(0) @db.UnsignedInt
  last_error       String?    @db.Text
  server_entity_id String?    @db.VarChar(100)
  created_at       DateTime   @default(now()) @db.DateTime(0)
  synced_at      DateTime?  @db.DateTime(0)
  device         SyncDevice @relation(fields: [device_id], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@index([entity_type, entity_id], map: "idx_outbox_entity")
  @@index([device_id, status, id], map: "idx_outbox_status")
  @@map("sync_outbox")
}

model Counter {
  id           BigInt      @id @default(autoincrement()) @db.UnsignedBigInt
  branch_id    BigInt      @db.UnsignedBigInt
  counter_no   Int         @db.UnsignedInt
  counter_name String?     @db.VarChar(50)
  cash_balance Decimal     @default(0.00) @db.Decimal(14, 2)
  is_active    Boolean     @default(true)
  created_at   DateTime    @default(now()) @db.DateTime(0)
  updated_at   DateTime    @updatedAt @db.DateTime(0)
  branch       Branch      @relation(fields: [branch_id], references: [id], onDelete: Restrict, onUpdate: Cascade)
  cash_shifts  CashShift[]

  @@unique([branch_id, counter_no], map: "uq_counters_branch_no")
  @@map("counters")
}

model CashShift {
  id              BigInt                   @id @default(autoincrement()) @db.UnsignedBigInt
  branch_id       BigInt                   @db.UnsignedBigInt
  counter_id      BigInt                   @db.UnsignedBigInt
  shift_code      String                   @db.VarChar(40)
  status          String                   @default("open") @db.VarChar(20)
  opened_at       DateTime                 @db.DateTime(0)
  closed_at       DateTime?                @db.DateTime(0)
  opening_cash    Decimal                  @default(0.00) @db.Decimal(14, 2)
  cash_sales      Decimal                  @default(0.00) @db.Decimal(14, 2)
  cash_in         Decimal                  @default(0.00) @db.Decimal(14, 2)
  cash_out        Decimal                  @default(0.00) @db.Decimal(14, 2)
  upi_card_sales  Decimal                  @default(0.00) @db.Decimal(14, 2)
  cash_refunds    Decimal                  @default(0.00) @db.Decimal(14, 2)
  expected_cash   Decimal                  @default(0.00) @db.Decimal(14, 2)
  closing_cash    Decimal?                 @db.Decimal(14, 2)
  variance        Decimal?                 @db.Decimal(14, 2)
  closing_note    String?                  @db.VarChar(255)
  open_counter_id BigInt?                  @unique(map: "uq_cash_shifts_one_open_counter") @db.UnsignedBigInt
  created_at      DateTime                 @default(now()) @db.DateTime(0)
  updated_at      DateTime                 @updatedAt @db.DateTime(0)
  branch          Branch                   @relation(fields: [branch_id], references: [id], onDelete: Restrict, onUpdate: Cascade)
  counter         Counter                  @relation(fields: [counter_id], references: [id], onDelete: Restrict, onUpdate: Cascade)
  users           CashShiftUser[]
  denominations   CashShiftDenomination[]

  @@unique([branch_id, counter_id, shift_code], map: "uq_cash_shifts_counter_code")
  @@index([counter_id, opened_at], map: "idx_cash_shifts_counter")
  @@map("cash_shifts")
}

model CashShiftUser {
  id         BigInt    @id @default(autoincrement()) @db.UnsignedBigInt
  shift_id   BigInt    @db.UnsignedBigInt
  user_id    BigInt    @db.UnsignedBigInt
  started_at DateTime  @db.DateTime(0)
  ended_at   DateTime? @db.DateTime(0)
  shift      CashShift @relation(fields: [shift_id], references: [id], onDelete: Restrict, onUpdate: Cascade)
  user       User      @relation(fields: [user_id], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@index([shift_id, started_at], map: "idx_cash_shift_users_shift")
  @@index([user_id, started_at], map: "idx_cash_shift_users_user")
  @@map("cash_shift_users")
}

model CashShiftDenomination {
  id           BigInt    @id @default(autoincrement()) @db.UnsignedBigInt
  shift_id     BigInt    @db.UnsignedBigInt
  kind         String    @db.VarChar(10)
  denomination Decimal   @db.Decimal(10, 2)
  quantity     Int       @db.UnsignedInt
  line_total   Decimal   @db.Decimal(14, 2)
  shift        CashShift @relation(fields: [shift_id], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@unique([shift_id, kind, denomination], map: "uq_cash_shift_denomination")
  @@map("cash_shift_denominations")
}
